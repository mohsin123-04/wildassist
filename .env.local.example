# Copy this file to `.env.local` and fill in your key. `.env.local` is gitignored.
#
# WildAssist works WITHOUT a key (it falls back to built-in rule-based guidance).
# Add a free Groq API key to turn on the smarter LLM triage.
#
# Get a free key (no credit card) at: https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Override the model. Default: openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# Supabase (database + auth). Create a project at https://supabase.com,
# then copy these from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
